#!/bin/sh
# Pre-commit gate for mivia-ai-sdk. Runs make verify-fast on the exact
# staged snapshot, never on the worktree. Installed via `make
# install-hooks` (sets core.hooksPath to .githooks). Never bypass with
# --no-verify or skip env vars. Fail closed: any export failure or gate
# failure blocks the commit.
set -e

if git diff --cached --quiet; then
	exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

tree=$(git write-tree)
git archive --format=tar "$tree" -o "$tmp/tree.tar"
mkdir "$tmp/stage"
tar -xf "$tmp/tree.tar" -C "$tmp/stage"

# git sets GIT_DIR/GIT_WORK_TREE (and friends) for every hook process,
# so a plain subprocess git call inside this "isolated" stage still
# resolves the real repository unless those vars are cleared first.
# That leak defeats check_test_tampering.py's no-.git skip and lets it
# run its full, message-blind check against the real diff.
env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
	-u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_COMMON_DIR -u GIT_PREFIX \
	make -C "$tmp/stage" verify-fast
