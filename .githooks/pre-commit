#!/bin/sh
# Pre-commit gate for mivia-ai-sdk. Runs make verify-fast on the exact
# staged snapshot, never on the worktree. Installed via `make
# install-hooks` (sets core.hooksPath to .githooks). Never bypass with
# --no-verify or skip env vars. Fail closed: any export failure or gate
# failure blocks the commit.
set -e

if git diff --cached --quiet; then
	exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

tree=$(git write-tree)
git archive --format=tar "$tree" -o "$tmp/tree.tar"
mkdir "$tmp/stage"
tar -xf "$tmp/tree.tar" -C "$tmp/stage"

make -C "$tmp/stage" verify-fast
